# 키움 REST API (모의투자면 KIWOOM_MOCK=1)
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
KIWOOM_MOCK=0
# 영웅문에서 저장한 조건식 이름
CONDITION_NAME=

# 네이버 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Claude 구독(Claude Code 로그인) 사용. 비우면 Claude Code 기본 모델
# 예: opus, sonnet, haiku
CLAUDE_MODEL=

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_agent
